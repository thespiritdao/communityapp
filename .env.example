# =============================================================================
# Environment configuration
#
# Copy to .env (or .env.local) and fill in your own values. Nothing here points
# at any real deployment: you bring your own Supabase project, Coinbase
# Developer Platform project, contracts, Hats tree and services.
#
# `npm run build` runs scripts/build/check-env.mjs first and stops with a list if a
# REQUIRED value is missing. docs/configuration.md explains each setting and
# docs/SETUP.md walks through creating everything in order.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle: never put a secret
# in one. Everything else stays on the server.
# =============================================================================


# ─── App ─────────────────────────────────────────────────────────────────────
# REQUIRED. Public URL of this deployment, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Display name used in titles, wallet prompts and email footers.
NEXT_PUBLIC_APP_NAME=Community App
# Public contact address (footers, receipts) and privacy/deletion address.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Organisation website, legal name and US EIN. Printed on donation receipts,
# which claim tax-deductibility: set these to your own registered values.
NEXT_PUBLIC_ORG_URL=
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_ORG_EIN=
# Wallets allowed to join without an invite code (bootstrap the first operator).
NEXT_PUBLIC_INVITE_BOOTSTRAP_WALLETS=
# Shared secret Vercel cron jobs send to /api/cron/*. REQUIRED.
CRON_SECRET=
# Secrets for signed event QR codes and internal server-to-server calls.
EVENT_QR_SECRET=
INTERNAL_API_KEY=
INTERNAL_API_SECRET=


# ─── Supabase ────────────────────────────────────────────────────────────────
# REQUIRED. Create the database from supabase/baseline/ first (see its README).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for scripts that apply migrations over Postgres.
SUPABASE_DB_PASSWORD=


# ─── Chain, wallets and gas sponsorship (Coinbase Developer Platform) ────────
# Base mainnet is 8453, Base Sepolia 84532. Much of the app assumes Base.
NEXT_PUBLIC_CHAIN_ID=8453
# REQUIRED. Your RPC endpoint and your CDP paymaster/bundler endpoint. Restrict
# the CDP client key to your own domains in the CDP portal.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RPC_FALLBACKS=
NEXT_PUBLIC_PAYMASTER=
# REQUIRED. CDP project id (embedded wallets) and client API key.
NEXT_PUBLIC_CDP_PROJECT_ID=
NEXT_PUBLIC_CDP_API_CLIENT=
# Server-side verification of embedded-wallet sessions (src/lib/cdpAuth.ts).
# Login fails closed without these.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Legacy names still read by some backend paths (same key as above).
CDP_API_KEY=
EXECUTIVE_MINTING_PRIVATE_KEY=
# Base builder code for ERC-8021 attribution (optional, e.g. bc_xxxxxxxx).
NEXT_PUBLIC_BUILDER_CODE=
NEXT_PUBLIC_BASE_APP_ID=


# ─── Backend signing keys ────────────────────────────────────────────────────
# Admin EOA used by the server for provisioning (minting, pod setup), and the
# CDP smart wallet it controls, which sends sponsored backend operations.
# Keep these out of version control; consider a key service for production.
POD_ADMIN_PRIVATE_KEY=
BACKEND_SMART_WALLET_ADDRESS=
# Key used by pod creation and onboarding mints (owner of PodCreationManager).
PRIVATE_KEY=
# $SELF attestor and community-agent wallet derivation.
SELF_ATTESTOR_PRIVATE_KEY=
AGENT_WALLET_MASTER_KEY=
# Hardhat deploys (falls back to PRIVATE_KEY / POD_ADMIN_PRIVATE_KEY).
DEPLOYER_PRIVATE_KEY=
BASESCAN_API_KEY=


# ─── Structural pods ─────────────────────────────────────────────────────────
# UUIDs of rows in the `pods` table. Each pod's management_hat_id is its leader
# hat and membership_hat_id its member hat (see src/lib/hatRegistry.ts).
# REQUIRED: the governance (executive) pod.
NEXT_PUBLIC_GOVERNANCE_POD_ID=
# Parent pod under which community pods are created.
NEXT_PUBLIC_COMMUNITY_POD_ID=
# Optional: community new members are enrolled in at onboarding.
NEXT_PUBLIC_DEFAULT_POD_ID=
# Optional: pod whose agent uses the dedicated Kairos persona and the shared
# philosophy index.
NEXT_PUBLIC_KAIROS_POD_ID=


# ─── Contracts ───────────────────────────────────────────────────────────────
# Hats Protocol, its module factory and Multicall3 have the same address on
# every chain.
NEXT_PUBLIC_HATS_CONTRACT=0x3bc1A0Ad72417f2d411118085256fC53CBdDd137
NEXT_PUBLIC_HATS_MODULE_FACTORY_ADDRESS=0xfE661c01891172046feE16D3a57c3Cf456729efA
NEXT_PUBLIC_MULTICALL_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
# Your deployments (see docs/SETUP.md for the order and which script deploys each).
# Tokens and membership NFTs (REQUIRED: SYSTEM, SELF, PROOF_OF_CURIOSITY)
NEXT_PUBLIC_SYSTEM_TOKEN=
NEXT_PUBLIC_SELF_TOKEN=
NEXT_PUBLIC_PROOF_OF_CURIOSITY=
NEXT_PUBLIC_ADVOCATE=
NEXT_PUBLIC_TOKEN_FAUCET=
NEXT_PUBLIC_TOKEN_CLAIM_ADDRESS=
# $SELF soulbound system
NEXT_PUBLIC_SELF_EPOCHS=
NEXT_PUBLIC_SELF_MINTER=
NEXT_PUBLIC_SELF_PAYMENT=
NEXT_PUBLIC_SELF_PRESTIGE=
NEXT_PUBLIC_SELF_RECEIPT=
# Governance
NEXT_PUBLIC_DAO_GOVERNOR=
NEXT_PUBLIC_DAO_TIMELOCK=
NEXT_PUBLIC_POD_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_POD_APPLICATION_VOTING=
# Pods, hats and eligibility
NEXT_PUBLIC_HAT_MINTER=
NEXT_PUBLIC_POD_CREATION_MANAGER=
NEXT_PUBLIC_POD_CREATION_MANAGER_FACTORY=
NEXT_PUBLIC_POD_AUTH_FACTORY=
NEXT_PUBLIC_POD_ELIGIBILITY_MODULE=
NEXT_PUBLIC_EXEC_MEMBER_TOGGLE_MODULE=
NEXT_PUBLIC_HAT_CONTROLLED_TOGGLE_MODULE=
NEXT_PUBLIC_TIME_BASED_TOGGLE_MODULE=
# Treasuries and bounties
NEXT_PUBLIC_POD_TREASURY_FACTORY=
NEXT_PUBLIC_TREASURY_PROXY=
NEXT_PUBLIC_BOUNTY_MANAGER_ADDRESS=
NEXT_PUBLIC_POD_BOUNTY_SERVICE=
NEXT_PUBLIC_POD_SELF_DISTRIBUTOR=
# Events and marketplace
NEXT_PUBLIC_EVENT_MANAGER=
NEXT_PUBLIC_EVENT_ESCROW_CONTRACT=
NEXT_PUBLIC_PURCHASE_ROUTER=
NEXT_PUBLIC_PURCHASE_ROUTER_DECENTRALIZED=
NEXT_PUBLIC_PURCHASE_BURN=
# AI agent registry and activity-ledger anchor (Congregant architecture)
NEXT_PUBLIC_AGENT_REGISTRY=
NEXT_PUBLIC_LEDGER_ANCHOR=
# Contract addresses the paymaster route may sponsor in addition to the ones
# above (comma-separated), e.g. pod treasuries during a proxy migration.
PAYMASTER_EXTRA_ALLOWLIST=


# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Required when RESEND_API_KEY is set, e.g. "Example Org <hello@example.org>".
EMAIL_FROM=
EMAIL_FROM_DONATIONS=
# Inbox that receives account-deletion requests (defaults to NEXT_PUBLIC_SUPPORT_EMAIL).
SUPPORT_EMAIL=


# ─── Files and IPFS ──────────────────────────────────────────────────────────
PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
PINATA_GATEWAY_DOMAIN=
# Public host for large media such as knowledge-base videos.
NEXT_PUBLIC_FILES_HOST=


# ─── AI (Sensemaker and community agents) ────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
# Required when PINECONE_API_KEY is set.
PINECONE_INDEX_NAME=
# Optional shared philosophy library index (Kairos pod and Sensemaker).
PINECONE_PHILOSOPHY_INDEX=
# Other sites allowed to embed the Sensemaker widget (comma-separated origins).
SENSEMAKER_ALLOWED_ORIGINS=
# Domain for synthetic agent auth accounts (<wallet>@<domain>). Do not change
# after agents exist.
AGENT_EMAIL_DOMAIN=
# Pods whose agent is funded by the organisation (comma-separated pod UUIDs).
COMMUNITY_AGENT_GRANT_FUNDED_POD_IDS=


# ─── Video (LiveKit) ─────────────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=


# ─── Donations (Stripe) ──────────────────────────────────────────────────────
STRIPE_SYSTEM_DONATION_KEY=
STRIPE_SYSTEM_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_SYSTEM_PUBLISHABLE_KEY=
STRIPE_DIRECT_DONATION_KEY=
STRIPE_DIRECT_DONATION_WEBHOOK_SECRET=
STRIPE_SETTLEMENT_SMALL=
STRIPE_SETTLEMENT_MEDIUM=
STRIPE_SETTLEMENT_LARGE=
DONATION_PLATFORM_FEE_PERCENTAGE=
DONATION_MIN_AMOUNT=
PURCHASE_ROUTER_ADMIN_KEY=


# ─── Push notifications, analytics, maps, misc ───────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Contact sent to OpenStreetMap Nominatim (required by its usage policy) when
# the Places module geocodes addresses.
GEOCODE_CONTACT_EMAIL=
PARAGRAPH_API=
# Optional partner-token staking gate (Hydrex pools).
NEXT_PUBLIC_HYDREX_STAKING_ENABLED=false
NEXT_PUBLIC_HYDREX_TGN_TOKEN=
NEXT_PUBLIC_HYDREX_TGN_POOLS=


# ─── Development flags ───────────────────────────────────────────────────────
NEXT_PUBLIC_VERBOSE_LOGS=false
NEXT_PUBLIC_PODS_TESTING=false
NEXT_PUBLIC_MIN_POD_LEADERS=1
NEXT_PUBLIC_FORCE_APPROVAL_FLOW=false
NEXT_PUBLIC_TEST_MULTI_APPROVAL=false


# ─── Legacy (still read by older code paths; unset in normal deployments) ────
# Per-role hat ids from before hats moved to the database. Leave empty.
NEXT_PUBLIC_MARKET_MANAGEMENT=
NEXT_PUBLIC_MARKET_ADMIN=
NEXT_PUBLIC_BOUNTY_MANAGEMENT=
NEXT_PUBLIC_BOUNTY_HAT=
NEXT_PUBLIC_FORUM_MANAGEMENT=
NEXT_PUBLIC_CHAT_MANAGEMENT=
NEXT_PUBLIC_EVENT_MANAGEMENT=
NEXT_PUBLIC_DEV_POD_HAT_ID=
NEXT_PUBLIC_OTHER_HAT=
NEXT_PUBLIC_OTHER_HAT_TOGGLE_MODULE=
NEXT_PUBLIC_EXECUTIVE_POD_MEMBER_TOGGLE_MODULE=
NEXT_PUBLIC_EXECUTIVE_TOKEN=
NEXT_PUBLIC_GOVERNANCE_TOKEN=
# Aliases of variables above.
NEXT_PUBLIC_HATS_PROTOCOL_ADDRESS=
NEXT_PUBLIC_PROOF_OF_CURIOSITY_TOKEN=
NEXT_PUBLIC_ADVOCATE_TOKEN_ADDRESS=
NEXT_PUBLIC_BASE_RPC_URL=
ADMIN_RPC_URL=
NEXTAUTH_URL=
NEXT_PUBLIC_SAFE_WALLET=
NEXT_PUBLIC_PODS_TESTING_MODE=
NEXT_PUBLIC_DEBUG_HAT_SYNC=

# ---------------------------------------------------------------------------
# Operator scripts (scripts/). Not read by the app. See scripts/README.md.
# ---------------------------------------------------------------------------
# Contract owner key for deploy/ and wiring scripts, and its address.
CONTRACT_ADMIN_PRIVATE_KEY=
CONTRACT_ADMIN_ADDRESS=
# Wearer of your top hat; only needed to attach eligibility modules to top-level hats.
TOP_HAT_PRIVATE_KEY=
# Signs SELF epoch advances (ops/advance-self-epoch.mjs).
ADMIN_EPOCH_PRIVATE_KEY=
# Hat ids used when deploying HatMinter and the AgentRegistry.
MEMBER_HAT_ID=
EXECUTIVE_POD_LEADER_HAT_ID=
# Optional owners for newly deployed contracts (default: the deployer / backend smart wallet).
HAT_MINTER_OWNER=
AGENT_REGISTRY_OWNER=
LEDGER_ANCHOR_OWNER=
# Database access for db/apply-migration.mjs and backups: a full URL, or password + pooler host.
SUPABASE_DB_URL=
SUPABASE_POOLER_HOST=
SUPABASE_STAGING_DB_URL=
# Source image for build/generate-pwa-icons.mjs.
PWA_ICON_SOURCE=
# Testnet deployment (deploy/deploy-testnet.mjs).
TESTNET_RPC_URL=
TESTNET_DEPLOYER_PRIVATE_KEY=
TESTNET_FAUCET_PRIVATE_KEY=
TESTNET_SYSTEM_TOKEN_NAME=
TESTNET_SELF_TOKEN_NAME=
TESTNET_GOVERNOR_NAME=
# Verify suites (scripts/verify). They create and delete test rows in your database.
VERIFY_BASE_URL=
VERIFY_POD_ID=
VERIFY_EMAIL_DOMAIN=
