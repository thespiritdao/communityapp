# SpiritDAO Testnet Environment Configuration
# Copy this file to .env.testnet and fill in your values
# Network: Base Sepolia (Testnet)

# ============================================================
# DEPLOYMENT
# ============================================================
# Your testnet deployer private key (needs testnet ETH)
# Get testnet ETH from: https://www.coinbase.com/faucets/base-ethereum-goerli-faucet
TESTNET_DEPLOYER_PRIVATE_KEY=0xyour_testnet_private_key_here
PRIVATE_KEY=0xyour_testnet_private_key_here
TESTNET_RPC_URL=https://sepolia.base.org

# ============================================================
# NETWORK CONFIGURATION
# ============================================================
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_IS_TESTNET=true
NEXT_PUBLIC_APP_NAME=SpiritDAO
NEXT_PUBLIC_MULTICALL_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# ============================================================
# TESTNET DATABASE (Separate Supabase Project Recommended)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-testnet-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_testnet_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_testnet_supabase_service_role_key
SUPABASE_JWT_SECRET=your_testnet_jwt_secret
SUPABASE_DB_PASSWORD=your_testnet_db_password

# ============================================================
# COINBASE & RPC
# ============================================================
CDP_API_KEY=your_cdp_api_key
NEXT_PUBLIC_CDP_API_CLIENT=your_cdp_client_id
NEXT_PUBLIC_PAYMASTER=https://api.developer.coinbase.com/rpc/v1/base-sepolia/your_paymaster_key

# ============================================================
# TESTNET-SPECIFIC FEATURES
# ============================================================
# Enable auto-airdrop for new users (testnet only)
NEXT_PUBLIC_ENABLE_AUTO_AIRDROP=true
NEXT_PUBLIC_TESTNET_AIRDROP_AMOUNT_SYSTEM=1000
NEXT_PUBLIC_TESTNET_AIRDROP_AMOUNT_SELF=500

# Relaxed permissions for beta testing
NEXT_PUBLIC_MIN_POD_LEADERS=1
NEXT_PUBLIC_FORCE_APPROVAL_FLOW=false
NEXT_PUBLIC_TEST_MULTI_APPROVAL=false

# Faster governance for testing
NEXT_PUBLIC_GOVERNANCE_VOTING_PERIOD=3600
NEXT_PUBLIC_GOVERNANCE_VOTING_DELAY=300
NEXT_PUBLIC_PROPOSAL_THRESHOLD=100

# ============================================================
# HATS PROTOCOL (Base Sepolia)
# ============================================================
# Note: Hats Protocol is deployed on Base Sepolia
NEXT_PUBLIC_HATS_CONTRACT=0x3bc1a0ad72417f2d411118085256fc53cbddd137
NEXT_PUBLIC_HATS_MODULE_FACTORY_ADDRESS=0xfE661c01891172046feE16D3a57c3Cf456729efA

# Testnet Hat IDs are stored in the hat_registry database table — not env vars.
# Run scripts/db-migrations/002_hat_registry.sql and update the rows with testnet hat IDs.

# ============================================================
# POD MANAGEMENT
# ============================================================
NEXT_PUBLIC_GOVERNANCE_POD_ID=your_testnet_governance_pod_id
NEXT_PUBLIC_COMMUNITY_POD_ID=your_testnet_community_pod_id

# ============================================================
# MEMBERSHIP TOKENS (NFTs) - Testnet Versions
# ============================================================
NEXT_PUBLIC_EVENT_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Deploy new testnet versions or use testnet addresses
NEXT_PUBLIC_PROOF_OF_CURIOSITY=
NEXT_PUBLIC_ADVOCATE=

# ============================================================
# AI SERVICES (Same as mainnet)
# ============================================================
OPENAI_API_KEY=your_openai_api_key
PINECONE_API_KEY=your_pinecone_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# ============================================================
# RATE LIMITING (UPSTASH REDIS) - Use separate testnet instance
# ============================================================
UPSTASH_REDIS_REST_URL=your_testnet_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_testnet_upstash_redis_token

# ============================================================
# EMAIL (SMTP) - Use testnet/staging email
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_testnet_email@domain.com
SMTP_PASSWORD=your_testnet_email_password

# ============================================================
# GELATO RELAY (Same key works for testnet)
# ============================================================
GELATO_RELAY_API_KEY=your_gelato_api_key

# ============================================================
# DEPLOYED CONTRACT ADDRESSES
# These will be auto-filled by the deployment script
# DO NOT EDIT MANUALLY - Run: npm run deploy:testnet
# ============================================================

# Tokens
NEXT_PUBLIC_SYSTEM_TOKEN=
NEXT_PUBLIC_SELF_TOKEN=

# Governance
NEXT_PUBLIC_DAO_GOVERNOR=
NEXT_PUBLIC_DAO_TIMELOCK=

# Purchase & Marketplace
NEXT_PUBLIC_PURCHASE_BURN=
NEXT_PUBLIC_PURCHASE_ROUTER=
NEXT_PUBLIC_PURCHASE_ROUTER_DECENTRALIZED=
NEXT_PUBLIC_USE_DECENTRALIZED_ROUTER=true

# Events
NEXT_PUBLIC_EVENT_MANAGER=
NEXT_PUBLIC_EVENT_REGISTRATION_FACTORY=
NEXT_PUBLIC_EVENT_COMPLETION_FACTORY=
NEXT_PUBLIC_EVENT_ESCROW=

# Pod Management
NEXT_PUBLIC_POD_AUTH_FACTORY=
NEXT_PUBLIC_POD_CREATION_MANAGER=
NEXT_PUBLIC_POD_TREASURY_FACTORY=
NEXT_PUBLIC_TREASURY_PROXY=
NEXT_PUBLIC_SIMPLE_POD_REGISTRY=

# Bounties
NEXT_PUBLIC_BOUNTY_MANAGER_ADDRESS=
NEXT_PUBLIC_POD_BOUNTY_SERVICE=

# Hats Modules
NEXT_PUBLIC_ELIGIBILITY_MODULE_ADDRESS=
NEXT_PUBLIC_TIME_BASED_TOGGLE_MODULE=
NEXT_PUBLIC_SIMPLE_TOGGLE_MODULE=
NEXT_PUBLIC_EXEC_MEMBER_TOGGLE_MODULE=

# ============================================================
# TESTNET FAUCET ACCOUNT
# Account that holds SYSTEM/SELF tokens to airdrop to new users
# ============================================================
TESTNET_FAUCET_PRIVATE_KEY=0xyour_faucet_account_private_key
TESTNET_FAUCET_ADDRESS=0xyour_faucet_account_address

# ============================================================
# NOTES FOR TESTNET
# ============================================================
# 1. Get testnet ETH from Base Sepolia faucet
# 2. Create separate Supabase project for testnet database
# 3. Use testnet-specific email/redis if available
# 4. All contract addresses will be filled by deployment script
# 5. Hats Protocol is already deployed on Base Sepolia
# 6. Test everything thoroughly before mainnet deployment
