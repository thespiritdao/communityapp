    "src/",
    "src/**/*"
  ],
  "main": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "module": "./esm/index.js",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./src/styles.css",
    "./tailwind.css": "./src/tailwind.css",
    "./theme": "./esm/styles/theme.js",
    ".": {
      "types": "./esm/index.d.ts",
      "module": "./esm/index.js",
      "import": "./esm/index.js",
