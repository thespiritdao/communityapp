{
  "name": "SpiritDAO Community App",
  "version": "0.35.6",
  "private": true,
  "repository": "https://github.com/thespiritdao/communityapp",
  "homepage": "https://app.spiritdao.org",
  "bugs": "https://github.com/thespiritdao/communityapp/issues",
  "license": "AGPL-3.0-only",
  "scripts": {
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "check": "biome check --write .",
    "check:unsafe": "biome check . --fix --unsafe",
    "ci:check": "biome ci --formatter-enabled=false --linter-enabled=false",
    "ci:format": "biome ci --linter-enabled=false --organize-imports-enabled=false",
    "ci:lint": "biome ci --formatter-enabled=false --organize-imports-enabled=false",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force node_modules\\.cache -ErrorAction SilentlyContinue\"",
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "lint:unsafe": "biome lint --write --unsafe .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "backup:database": "tsx scripts/backup-database.ts",
    "restore:database": "tsx scripts/restore-database.ts",
    "restore:list": "tsx scripts/restore-database.ts -- --list",
    "pinecone:setup": "tsx scripts/setup-pinecone-index.ts",
    "pinecone:test": "tsx scripts/test-pinecone-indexes.ts",
    "embed:spiritdao": "tsx scripts/embed-spiritdao-docs.ts",
    "deploy:testnet": "node scripts/deploy-testnet.mjs",
    "dev:testnet": "cross-env NODE_ENV=development DOTENV_CONFIG_PATH=.env.testnet next dev",
    "build:testnet": "cross-env DOTENV_CONFIG_PATH=.env.testnet next build",
    "start:testnet": "cross-env DOTENV_CONFIG_PATH=.env.testnet next start",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "verify:static": "node scripts/check-profile-email-leaks.mjs",
    "verify:exposure": "node scripts/check-anon-exposure.mjs",
    "verify:authority": "node scripts/audit-probes.mjs && node scripts/verify-authority.mjs",
    "verify:linking": "node scripts/wallet-link-e2e.mjs",
    "verify:qr": "node scripts/event-qr-e2e.mjs",
    "verify:invites": "node scripts/leader-invites-e2e.mjs",
    "verify:prod": "npm run verify:static && npm run verify:exposure && npm run verify:session && npm run verify:authority && npm run verify:linking && npm run verify:qr && npm run verify:invites",
    "hooks:install": "node scripts/install-hooks.mjs",
    "verify:session": "node scripts/verify-issued-session.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@coinbase/cdp-core": "^0.0.73",
    "@coinbase/cdp-hooks": "^0.0.73",
    "@coinbase/cdp-sdk": "1.44.0",
    "@coinbase/coinbase-sdk": "^0.25.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@hatsprotocol/modules-sdk": "^1.5.2",
    "@hatsprotocol/sdk-v1-core": "^0.12.4",
    "@hatsprotocol/sdk-v1-subgraph": "^1.0.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@openzeppelin/contracts": "^5.2.0",
    "@pinecone-database/pinecone": "^6.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@wagmi/core": "^2.17.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.12.0",
    "eruda": "^3.4.3",
    "ethers": "^6.15.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "livekit-client": "^2.17.2",
    "livekit-server-sdk": "^2.15.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.11.2",
    "next": "^15.5.26",
    "openai": "^6.25.0",
    "ox": "^0.12.1",
    "pg": "^8.18.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-datepicker": "^8.2.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.54.0",
    "react-hot-toast": "^2.5.2",
    "react-markdown": "^10.0.0",
    "react-mentions": "^4.4.10",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.3",
    "stripe": "^20.3.0",
    "styled-components": "^6.1.14",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.33.3",
    "wagmi": "^2.15.6",
    "web-push": "^3.6.7",
    "web3": "^4.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^14.2.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.18",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-mentions": "^4.4.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^2.0.5",
    "@vitest/ui": "^2.0.5",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.6.1",
    "hardhat": "^2.23.0",
    "jsdom": "^24.1.0",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^2.0.5"
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
